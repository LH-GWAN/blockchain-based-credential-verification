# 대구 혜택패스 환경변수 예시. 어떤 스크립트도 .env 를 자동으로 읽지 않는다 (docker compose 는 ${...} 치환에만 쓴다).
# 값을 비워 두면 각 코드의 기본값을 쓴다. 키는 모두 Hardhat 공개 계정 — 로컬 전용, 절대 실서비스 사용 금지.

# ---- 블록체인 ----
RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337
# 거버넌스(발급기관 등록·키 교체): Hardhat 계정 #0
GOVERNANCE_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
# 배포 주소 파일 (주석으로 두면 chain/deployments/latest.json, compose 는 named volume 의 파일)
# DEPLOYMENT_FILE=chain/deployments/latest.json

# ---- 원장 시드 (scripts/seed_ledger.py) — 발급기관별 접미사 변수 ----
# 비우면 대구시 = Hardhat #1, 복지기관 = Hardhat #2, Ed25519 시드 = 발급기관 ID 에서 결정론적으로 생성.
# 바꾸면 아래 발급기관 인스턴스의 ISSUER_EVM_PRIVATE_KEY / ISSUER_ED25519_SEED 에도 같은 값을 넣어야 한다.
# (다르면 상태목록 게시가 NOT_LIST_OWNER 로 실패한다. 이미 등록된 원장과 다르면 시드 스크립트가 멈추고 알려 준다.)
ISSUER_EVM_PRIVATE_KEY_DAEGU=0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d
ISSUER_EVM_PRIVATE_KEY_WELFARE=0x5de4111afa1a4b94908f83103eb1f1706367c2e68ca870fc3fb9a804cdab365a
ISSUER_ED25519_SEED_DAEGU=
ISSUER_ED25519_SEED_WELFARE=

# ---- 발급기관 인스턴스 (python -m dbp_issuer, 인스턴스마다 override) ----
# ISSUER_ID: daegu (대구광역시, 포트 8001) | welfare (사회보장정보원(복지기관), 포트 8003)
ISSUER_ID=daegu
ISSUER_PORT=8001
ISSUER_DB_PATH=.demo/issuer-daegu.db
# 비우면 ISSUER_ID 의 기본 키(위 접미사 변수의 기본값과 같음)
ISSUER_EVM_PRIVATE_KEY=
# 32바이트 hex. 비우면 결정론적 시드
ISSUER_ED25519_SEED=
# 설정하면 /admin/* 에 X-Admin-Token 헤더가 필요하다. 비우면 루프백(127.0.0.1·::1) 요청만 허용
ADMIN_TOKEN=

# ---- 검증기관 ----
VERIFIER_ID=imbank-branch-01
# 제출 영수증 앵커용: Hardhat 계정 #3 (발급기관 컨트롤러 키와 겹치지 않게)
VERIFIER_EVM_PRIVATE_KEY=0x7c852118294e51e653712a81e05800f419141751be58f605c371e15141b007a6
VERIFIER_PORT=8002
VERIFIER_PUBLIC_URL=http://localhost:8002
# 받는 규칙 버전 (쉼표 구분, bundle@version)
ACCEPTED_BUNDLES=daegu-eligibility@2026.2

# ---- Python 서비스 공통 (발급기관·검증기관·AI) ----
# 바인딩 주소: 기본 127.0.0.1 (compose 는 0.0.0.0)
HOST=127.0.0.1
# CORS 허용 출처 (쉼표 구분). 주석으로 두거나 비우면 기본값 = localhost/127.0.0.1 의 3000·3001·3010·3011
# ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3010,http://localhost:3011,http://127.0.0.1:3000,http://127.0.0.1:3001,http://127.0.0.1:3010,http://127.0.0.1:3011

# ---- 지갑 앱 (빌드 시 인라인, 선택) ----
# 공동원장 컨트랙트 주소. 있으면 지갑이 발급기관 /ledger/deployment 에 묻지 않고 원장을 직접 읽는다 (F40).
# make demo 는 chain/deployments/latest.json 에서 읽어 자동으로 넣는다.
# NEXT_PUBLIC_RULE_REGISTRY_ADDRESS=
# NEXT_PUBLIC_STATUS_LIST_REGISTRY_ADDRESS=
# NEXT_PUBLIC_RECEIPT_ANCHOR_ADDRESS=

# ---- AI ----
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5
# anthropic | template
LLM_PROVIDER=anthropic
AI_PORT=8004

# ---- 규칙 평가 기준일 (테스트 결정론) ----
RULE_EVAL_DATE=2026-09-14
